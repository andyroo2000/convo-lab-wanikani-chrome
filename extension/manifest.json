{
  "manifest_version": 3,
  "name": "ConvoLab Study Tracker",
  "description": "Records active WaniKani review and Satori Reader time in ConvoLab.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "https://convo-lab.com/*",
    "https://wanikani.com/*",
    "https://*.wanikani.com/*",
    "https://satorireader.com/*",
    "https://www.satorireader.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ConvoLab Study Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wanikani.com/*",
        "https://*.wanikani.com/*",
        "https://satorireader.com/*",
        "https://www.satorireader.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
