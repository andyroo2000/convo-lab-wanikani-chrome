{
  "manifest_version": 3,
  "name": "ConvoLab Study Tracker",
  "description": "Tracks study time and turns Netflix or YouTube dialogue into ConvoLab listening cards.",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "idle",
    "offscreen",
    "tabCapture",
    "storage"
  ],
  "host_permissions": [
    "https://convo-lab.com/*",
    "https://wanikani.com/*",
    "https://*.wanikani.com/*",
    "https://satorireader.com/*",
    "https://www.satorireader.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.netflix.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "ConvoLab Study Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wanikani.com/*",
        "https://*.wanikani.com/*",
        "https://satorireader.com/*",
        "https://www.satorireader.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "lib/subtitles.js",
        "media-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "lib/audio.js",
        "lib/screenshot-buffer.js",
        "lib/screenshot-picker.js",
        "lib/editor-controls.js",
        "media-content.js"
      ],
      "css": [
        "media-content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
